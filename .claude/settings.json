{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/structured-change-reminder.py\" 2>/dev/null || true",
            "statusMessage": "Checking for structured changes..."
          }
        ]
      }
    ]
  }
}
